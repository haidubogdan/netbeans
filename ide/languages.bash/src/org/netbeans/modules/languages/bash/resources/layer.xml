<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE filesystem PUBLIC "-//NetBeans//DTD Filesystem 1.2//EN" "http://www.netbeans.org/dtds/filesystem-1_2.dtd">
<filesystem>
    <folder name="Editors">
        <folder name="application">
            <folder name="x-sh">
                <attr name="displayName" stringvalue="Bash"/>
                <folder name="FontsColors">
                    <folder name="NetBeans">
                        <folder name="Defaults">
                            <file name="FontAndColors.xml" url="FontAndColors.xml">
                                <attr name="SystemFileSystem.localizingBundle" stringvalue="org.netbeans.modules.languages.bash.resources.Bundle"/>
                            </file>
                        </folder>
                    </folder>
                    <folder name="BlueTheme">
                        <folder name="Defaults">
                            <file name="FontAndColors-bluetheme.xml" url="FontAndColors-bluetheme.xml">
                                <attr name="SystemFileSystem.localizingBundle" stringvalue="org.netbeans.modules.languages.bash.resources.Bundle"/>
                            </file>
                        </folder>
                    </folder>
                    <folder name="FlatLafDark">
                        <folder name="Defaults">
                            <file name="FontAndColors-darktheme.xml" url="FontAndColors-darktheme.xml">
                                <attr name="SystemFileSystem.localizingBundle" stringvalue="org.netbeans.modules.languages.bash.resources.Bundle"/>
                            </file>
                        </folder>
                    </folder>
                </folder>
            </folder> 
        </folder>
    </folder>
    <folder name="Loaders">
        <folder name="application">
            <folder name="x-sh">
                <attr name="iconBase" stringvalue="org/netbeans/modules/languages/bash/resources/sh_file_16.png"/>
            </folder>
        </folder>
    </folder>
    <folder name="OptionsDialog">
        <folder name="PreviewExamples">
            <folder name="application">
                <file name="x-sh" url="coloring.sh"/>
            </folder>
        </folder>
    </folder>
</filesystem>
